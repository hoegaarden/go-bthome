+// IsValid checks if the packet contains valid data according to BTHome specification.
+func (p Packet) IsValid() error {
+	if p.BTHomeVersion < 1 || p.BTHomeVersion > 2 {
+		return fmt.Errorf("unsupported BTHome version: %d", p.BTHomeVersion)
+	}
+	
+	if p.Battery != nil && *p.Battery > 100 {
+		return fmt.Errorf("invalid battery percentage: %d", *p.Battery)
+	}
+	
+	if p.Humidity != nil && *p.Humidity > 100 {
+		return fmt.Errorf("invalid humidity percentage: %d", *p.Humidity)
+	}
+	
+	return nil
